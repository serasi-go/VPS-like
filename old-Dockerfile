FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic tools
RUN apt update && apt install -y \
    curl wget git nano sudo \
    python3 python3-pip \
    nodejs npm \
    xfce4 xfce4-goodies \
    tightvncserver \
    novnc websockify

# Install code-server
RUN curl -fsSL https://code-server.dev/install.sh | sh

# Create user
RUN useradd -m railway \
    && echo "railway:railway" | chpasswd \
    && adduser railway sudo

USER railway
WORKDIR /home/railway

# Setup VNC password
RUN mkdir -p /home/railway/.vnc \
    && echo "railway" | vncpasswd -f > /home/railway/.vnc/passwd \
    && chmod 600 /home/railway/.vnc/passwd

# Copy your app
WORKDIR /home/railway/app
COPY . .

RUN npm install || true

# Copy start script
USER root
COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 3000

CMD ["/start.sh"]
